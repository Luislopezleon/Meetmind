# Database Configuration
DATABASE_URL=postgresql://meetmind:meetmind@db:5432/meetmind
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=meetmind
POSTGRES_DB=meetmind

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
RECALL_AI_API_KEY=your_recall_ai_api_key_here

# Recall.ai Configuration
RECALL_REGION=eu-central-1

# Jira Configuration (opcional)
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your_jira_api_token

# Notion Configuration (opcional)
NOTION_API_KEY=your_notion_integration_key
NOTION_DATABASE_ID=your_notion_database_id

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Webhook Configuration (Svix signing secret from Recall dashboard)
RECALL_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here